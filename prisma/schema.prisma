generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  EDITOR
}

enum TipoQuestao {
  MULTIPLA_ESCOLHA
  VERDADEIRO_FALSO
  ABERTA
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EDITOR)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Edicao {
  id        String   @id @default(cuid())
  nome      String   @unique
  ativa     Boolean  @default(false)
  createdAt DateTime @default(now())

  grupos        Grupo[]
  questoes      Questao[]
  configuracoes Configuracao[]
  submissoes    Submissao[]
  certificado   CertificadoModelo?
  ebooks        EbookArquivo[]
}

// PDF entregue ao final da pesquisa. Fica no banco em partes de até 3 MB porque
// a Vercel limita cada requisição a 4,5 MB; só o arquivo `completo` é usado.
model EbookArquivo {
  id          String       @id @default(cuid())
  edicaoId    String
  edicao      Edicao       @relation(fields: [edicaoId], references: [id])
  nome        String
  tamanho     Int
  totalPartes Int
  completo    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  partes      EbookParte[]

  @@index([edicaoId])
}

model EbookParte {
  id        String       @id @default(cuid())
  arquivoId String
  arquivo   EbookArquivo @relation(fields: [arquivoId], references: [id], onDelete: Cascade)
  indice    Int
  dados     Bytes        @db.LongBlob

  @@unique([arquivoId, indice])
}

model Grupo {
  id        String      @id @default(cuid())
  edicaoId  String
  edicao    Edicao      @relation(fields: [edicaoId], references: [id])
  numero    Int
  nome      String
  ativo     Boolean     @default(true)
  createdAt DateTime    @default(now())
  submissoes Submissao[]

  @@unique([edicaoId, numero])
}

model Configuracao {
  id       String @id @default(cuid())
  edicaoId String
  edicao   Edicao @relation(fields: [edicaoId], references: [id])
  chave    String
  valor    String @db.Text

  @@unique([edicaoId, chave])
}

// Modelo do certificado de cada edição: imagem de fundo + posição do nome da aluna.
// Posições e tamanho em % (nomeX/nomeY da imagem; fonteTamanho da largura).
model CertificadoModelo {
  id           String   @id @default(cuid())
  edicaoId     String   @unique
  edicao       Edicao   @relation(fields: [edicaoId], references: [id])
  ativo        Boolean  @default(true)
  imagem       Bytes?   @db.LongBlob
  imagemTipo   String?
  nomeX        Float    @default(12)
  nomeY        Float    @default(32.4)
  fonteTamanho Float    @default(3.4)
  fonte        String   @default("Dancing Script")
  cor          String   @default("#1a1208")
  alinhamento  String   @default("left")
  updatedAt    DateTime @updatedAt
}

model Questao {
  id        String      @id @default(cuid())
  edicaoId  String
  edicao    Edicao      @relation(fields: [edicaoId], references: [id])
  texto     String      @db.Text
  tipo      TipoQuestao @default(MULTIPLA_ESCOLHA)
  pontos    Int         @default(1)
  ordem     Int
  ativa     Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  opcoes    Opcao[]
  respostas Resposta[]
}

model Opcao {
  id        String     @id @default(cuid())
  texto     String
  correta   Boolean    @default(false)
  ordem     Int
  questaoId String
  questao   Questao    @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  respostas Resposta[]
}

model Submissao {
  id        String     @id @default(cuid())
  edicaoId  String
  edicao    Edicao     @relation(fields: [edicaoId], references: [id])
  nome      String
  whatsapp  String
  grupoId   String?
  grupo     Grupo?     @relation(fields: [grupoId], references: [id])
  pontuacao Int        @default(0)
  createdAt DateTime   @default(now())

  respostas Resposta[]
}

model Resposta {
  id          String    @id @default(cuid())
  submissaoId String
  questaoId   String
  opcaoId     String?
  textoLivre  String?   @db.Text

  submissao Submissao @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  questao   Questao   @relation(fields: [questaoId], references: [id])
  opcao     Opcao?    @relation(fields: [opcaoId], references: [id])

  @@unique([submissaoId, questaoId])
}
